{
  "expo": {
    "name": "Eclipse Cam",
    "slug": "eclipse-cam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eclipse-cam",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.replit.eclipsecam",
      "infoPlist": {
        "NSCameraUsageDescription": "Eclipse Cam utilise l'appareil photo pour capturer automatiquement les photos de la séquence.",
        "NSPhotoLibraryAddUsageDescription": "Eclipse Cam sauvegarde les photos de la séquence dans votre galerie.",
        "NSMicrophoneUsageDescription": "Accès au micro requis par l'API caméra iOS."
      }
    },
    "android": {
      "package": "com.replit.eclipsecam",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "WRITE_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#08090e"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
